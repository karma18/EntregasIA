{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/mark-api-tests.ps1",
        "timeout": 15
      }
    ],
    "afterTabFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/mark-api-tests.ps1",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/run-api-tests.ps1",
        "timeout": 240,
        "loop_limit": 2
      }
    ]
  }
}
